{
  "name": "slack-analyze-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "desktop": "electron electron",
    "desktop:dev": "concurrently -k -n web,desktop -c magenta,cyan \"npm:dev\" \"wait-on -t 180000 http-get://localhost:3000 && electron electron\"",
    "desktop:pack": "electron-builder --dir",
    "desktop:dist": "electron-builder"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-toastify": "^11.1.0",
    "recharts": "^2.15.4",
    "swr": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "wait-on": "^9.5.1"
  },
  "description": "Slack Analyze dashboard (Next.js) and its desktop app (Electron)",
  "author": "unybrands",
  "build": {
    "appId": "com.unybrands.slackanalyze",
    "productName": "Slack Analyze",
    "copyright": "Copyright © 2026 unybrands",
    "directories": {
      "app": "electron",
      "output": "dist-desktop"
    },
    "files": [
      "**/*",
      "!node_modules{,/**/*}"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "electron/assets/icon.ico",
      "artifactName": "Slack-Analyze-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Slack Analyze",
      "runAfterFinish": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "electron/assets/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Network",
      "icon": "electron/assets/icon.png"
    }
  }
}
